# URL base do backend Django
VITE_API_BASE_URL=http://127.0.0.1:8000

# Campo enviado para o endpoint /api/token/
# Use "email" porque o backend enviado usa Usuario com USERNAME_FIELD = email.
# Só troque para "username" se você voltar para o User padrão do Django.
VITE_LOGIN_FIELD=email

# Endpoints principais do backend Django
VITE_REGISTRO_ENDPOINT=/api/clientes/
VITE_TOKEN_ENDPOINT=/api/token/
VITE_TOKEN_REFRESH_ENDPOINT=/api/token/refresh/
VITE_PERFIS_ENDPOINT=/api/perfis/
VITE_USUARIOS_ENDPOINT=/api/usuario/  # Use /api/usuario/ ou /api/usuarios/ conforme o backend
VITE_SERVICOS_ENDPOINT=/api/servicos/
VITE_AGENDAMENTOS_ENDPOINT=/api/agendamentos/
